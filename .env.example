# ==============================================================================
# TwinOps Enterprise Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local: cp .env.example .env.local
# 2. Populate the required environment variables with your enterprise credentials.
# 3. Never commit .env.local or any secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core LLM Inference Provider
# ------------------------------------------------------------------------------
# Supports direct OpenAI, Azure OpenAI Service, OpenRouter, or compatible gateways.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Optional fallback provider
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# 2. Application Network Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Enterprise PostgreSQL & Vector Storage (Supabase / AWS RDS / Azure Postgres)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database flag (optional: set to 'true' to enforce Supabase memory pipeline)
USE_SUPABASE_MEMORY=true

# ------------------------------------------------------------------------------
# 4. Enterprise Connectors & Collaboration
# ------------------------------------------------------------------------------

# Microsoft Teams (Power Automate Workflow Incoming Webhook)
TEAMS_WEBHOOK_URL=

# Jira Cloud / Jira Data Center
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# GitHub Enterprise / Cloud (Personal Access Token or GitHub App Token)
GITHUB_ACCESS_TOKEN=

# Slack Enterprise Grid / Workspace (Bot Token & Signing Secret)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Notion Workspace Integration
NOTION_API_KEY=

# Google Workspace / Drive / Gmail OAuth2 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
