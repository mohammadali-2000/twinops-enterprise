# ==============================================================================
# TwinOps Enterprise Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local: cp .env.example .env.local
# 2. Populate the required environment variables with your enterprise credentials.
# 3. Never commit .env.local or any secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core LLM Inference Provider
# ------------------------------------------------------------------------------
# Supports direct OpenAI, Azure OpenAI Service, OpenRouter, or compatible gateways.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
# Must produce 1536-dim vectors. With OpenRouter use openai/text-embedding-3-small
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: OpenRouter instead of OpenAI. Also set OPENAI_BASE_URL=https://openrouter.ai/api/v1
# and OPENAI_MODEL=openai/gpt-4o. Embeddings still require an OpenAI-compatible embeddings endpoint.
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# 2. Application Network Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Enterprise PostgreSQL & Vector Storage (Supabase / AWS RDS / Azure Postgres)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for RAG: the agent only retrieves memories when this is 'true'.
USE_SUPABASE_MEMORY=true

# ------------------------------------------------------------------------------
# 4. Enterprise Connectors & Collaboration
# ------------------------------------------------------------------------------

# Microsoft Teams
# Outgoing cards (Workflows "Post to a channel when a webhook request is received"):
TEAMS_WEBHOOK_URL=
# Shared secret the Power Automate flow sends in the x-twinops-secret header to /api/teams/events.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TEAMS_FLOW_SECRET=

# Jira Cloud (API token from https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# GitHub personal access token (fine-grained, read-only: Contents, Metadata, Pull requests)
GITHUB_TOKEN=

# Slack Enterprise Grid / Workspace (Bot Token & Signing Secret)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Notion Workspace Integration
NOTION_API_KEY=

# Google Workspace / Drive / Gmail OAuth2 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
